<?xml version="1.0" encoding="UTF-8"?>
<!--
  A simplified subset of ISO 20022 pain.001 (customer credit transfer initiation).
  It keeps the real element names, so the structure reads like the bank format,
  but drops the parts this project does not use. Rules that XSD 1.0 cannot express
  (NbOfTxs and CtrlSum must match the transactions, EndToEndId must be unique)
  are checked in Java after validation.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:bank-core:pain.001.simplified"
           targetNamespace="urn:bank-core:pain.001.simplified"
           elementFormDefault="qualified">

  <xs:element name="Document" type="Document"/>

  <xs:complexType name="Document">
    <xs:sequence>
      <xs:element name="CstmrCdtTrfInitn" type="CustomerCreditTransferInitiation"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CustomerCreditTransferInitiation">
    <xs:sequence>
      <xs:element name="GrpHdr" type="GroupHeader"/>
      <xs:element name="PmtInf" type="PaymentInformation"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="GroupHeader">
    <xs:sequence>
      <xs:element name="MsgId" type="Max35Text"/>
      <xs:element name="CreDtTm" type="xs:dateTime"/>
      <xs:element name="NbOfTxs" type="xs:positiveInteger"/>
      <xs:element name="CtrlSum" type="DecimalAmount"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PaymentInformation">
    <xs:sequence>
      <xs:element name="DbtrAcct" type="CashAccount"/>
      <xs:element name="CdtTrfTxInf" type="CreditTransferTransaction" maxOccurs="1000"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CashAccount">
    <xs:sequence>
      <xs:element name="IBAN" type="IbanCode"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CreditTransferTransaction">
    <xs:sequence>
      <xs:element name="PmtId">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="EndToEndId" type="Max35Text"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="Amt">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="InstdAmt" type="ActiveCurrencyAndAmount"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="Cdtr">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Nm" type="Max140Text"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="CdtrAcct" type="CashAccount"/>
      <xs:element name="RmtInf" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Ustrd" type="Max140Text"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ActiveCurrencyAndAmount">
    <xs:simpleContent>
      <xs:extension base="DecimalAmount">
        <xs:attribute name="Ccy" type="CurrencyCode" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:simpleType name="DecimalAmount">
    <xs:restriction base="xs:decimal">
      <xs:minExclusive value="0"/>
      <xs:fractionDigits value="2"/>
      <xs:totalDigits value="18"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CurrencyCode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="UAH"/>
      <xs:enumeration value="USD"/>
      <xs:enumeration value="EUR"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="IbanCode">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z]{2}[0-9]{2}[A-Z0-9]{11,30}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Max35Text">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="35"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Max140Text">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="140"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
